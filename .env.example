# ==============================================================================
# ZYVEN STORE — Variables de Entorno (.env.example)
# ==============================================================================

# Entorno de aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (Plan Gratuito)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Bootstrap del administrador inicial (solo server-side)
INITIAL_ADMIN_EMAIL="admin@zyvenstore.com.ar"

# Seguridad interna (HMAC para tokens de orden invitado y Cron de Vercel)
ORDER_TOKEN_SECRET="cambiar-por-secreto-aleatorio-de-al-menos-32-bytes"
CRON_SECRET="cambiar-por-secreto-de-cron-de-al-menos-32-bytes"

# Mercado Pago (Credenciales de Sandbox en desarrollo / Productivas solo en prod)
MP_ACCESS_TOKEN="APP_USR-..."
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="secreto-webhook-mercadopago"

# Simulador logístico (SOLO permitido cuando NODE_ENV !== 'production')
ENABLE_SHIPPING_SIMULATOR="true"

# Resend (Plan Gratuito: 100/día, 3.000/mes)
RESEND_API_KEY="re_..."
EMAIL_FROM="Zyven Store <no-reply@zyvenstore.com.ar>"

# Monitoreo y Analítica (Planes Gratuitos, opcionales en desarrollo local)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
